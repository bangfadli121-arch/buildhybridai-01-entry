# Salin ke .env dan isi dengan Firebase config project kamu.
# JANGAN commit file .env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Debug token App Check (sudah terdaftar di Firebase console). Kosongkan saat
# local dev bila belum punya — SDK akan generate token baru dan menampilkannya
# di console browser; daftarkan token itu dulu di console sebelum dipakai.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
# Site key reCAPTCHA v3 untuk App Check (production). Kosongkan saat local dev.
VITE_RECAPTCHA_SITE_KEY=
